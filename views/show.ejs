<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Blog Details | BlogSpace</title>
    <link rel="stylesheet" href="/style.css">
</head>
<body>

    <h1>Blog Details</h1>

    <div class="detail-container">

        <p class="blog-id">Blog ID: <%= post.id %></p>

        <h2 class="user"><%= post.username %></h2>

        <div class="blog-content">
            <%= post.content %>
        </div>

        <a href="/posts" class="back-btn">← Back to Blogs</a>

    </div>

</body>
</html>